  "cards": [
    {
      "dot": "cyan",
      "title": "SpatialGuide & Edits",
      "items": [
        "GuideRenderer produces byte-deterministic Blockout and OverlayGuide PNGs via tiny-skia and resvg",
        "WholeImageEdit forwards target + references without silent post-generation re-grading",
        "PatchEdit uses a 1:1 crop, PatchPrepMode, collar OKLab Reinhard transfer, and 5-level Laplacian blend"
      ]
    },
    {
      "dot": "rose",
      "title": "Drift QA & Deterministic Export",
      "items": [
        "outOfRoi DeltaE_2000 guarantees zero mutation outside the PatchEdit composite footprint",
        "Export enforces source <= profile Visibility before emitting web-webp, vtt-token, or vtt-map",
        "Damped L* CDF (0.25..=0.45) and .cube 3D LUT grading run only under explicit --match-grade"
      ]
    }
