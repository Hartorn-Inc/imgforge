  "cards": [
    {
      "dot": "cyan",
      "title": "Strict Forward Lifecycle",
      "items": [
        "Run and ReferencePack progress strictly: draft -> candidate -> validated -> canonical -> superseded",
        "Seed (SeedInput) is strictly a bootstrap input role and never enters Lifecycle",
        "Canonical assets are immutable and frozen by SHA-256 in library/manifest.lock.json"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-Closed Gates",
      "items": [
        "ColorQaEngine and VisionCritic reject failing candidates back to draft for revision",
        "Visibility (public < restricted < internal) guards both Atlas packing and Export",
        "Export produces reproducible deliverables without creating independent Lifecycle versions"
      ]
    }
  ]
